<style>
    /* Базовые настройки для всего блока */
    .bilim-wrapper {
        all: initial; /* Сброс стилей Google Сайта */
        display: block;
        font-family: 'Segoe UI', sans-serif;
        background: #000;
        padding: 20px;
        border-radius: 40px;
        color: #fff;
    }

    /* Жидкое стекло для контейнера */
    .glass-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 40px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    /* Таймер с черными цифрами в белом стекле */
    .timer-pill {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 30px;
        padding: 15px;
        text-align: center;
        margin-bottom: 20px;
    }

    .timer-pill span {
        color: #000;
        font-size: 32px;
        font-weight: 900;
    }

    /* Плавные карточки уроков */
    .lesson {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 25px;
        padding: 15px;
        margin: 10px 0;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>

<div class="bilim-wrapper">
    <div class="glass-card">
        <div class="timer-pill">
            <span id="live-clock">00:00:00</span>
        </div>
        
        <div class="lesson">
            <strong>Математика</strong><br>
            <small>Кабинет 204</small>
        </div>
        <div class="lesson">
            <strong>Русский язык</strong><br>
            <small>Кабинет 310</small>
        </div>
    </div>
</div>

<script>
    // Скрипт часов прямо внутри файла
    function startClock() {
        const clockEl = document.getElementById('live-clock');
        if (clockEl) {
            setInterval(() => {
                clockEl.innerText = new Date().toLocaleTimeString('ru-RU');
            }, 1000);
        }
    }
    startClock();
</script>
