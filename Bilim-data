/* =========================
   WEEKEND
========================= */

.weekend-card{

    display:none;

    padding:35px;

    border-radius:28px;

    text-align:center;

    font-size:20px;
    font-weight:900;

    color:#166534;

    background:
    linear-gradient(
        145deg,
        rgba(240,255,247,0.95),
        rgba(220,255,235,0.72)
    );

    box-shadow:
    0 0 30px rgba(125,255,178,0.14);
}

/* =========================
   ANIMATIONS
========================= */

@keyframes liquidMove{

    0%{
        transform:
        rotateX(2deg)
        rotateY(-2deg)
        translateY(0px);
    }

    50%{
        transform:
        rotateX(0deg)
        rotateY(0deg)
        translateY(-4px);
    }

    100%{
        transform:
        rotateX(-2deg)
        rotateY(2deg)
        translateY(4px);
    }
}

@keyframes fabricMove{

    0%,100%{
        transform:
        skewX(-1deg)
        skewY(1deg);
    }

    50%{
        transform:
        skewX(1deg)
        skewY(-1deg);
    }
}

@keyframes premiumGlow{

    0%,100%{
        opacity:0.7;
        transform:scale(1);
    }

    50%{
        opacity:1;
        transform:scale(1.02);
    }
}

@keyframes airplaneFly{

    0%{
        transform:
        translateY(0)
        translateX(-5px)
        rotate(0deg);
    }

    100%{
        transform:
        translateY(-8px)
        translateX(5px)
        rotate(3deg);
    }
}

@keyframes airplaneFloat{

    0%,100%{
        filter:
        drop-shadow(0 0 18px rgba(125,255,178,0.35));
    }

    50%{
        filter:
        drop-shadow(0 0 30px rgba(125,255,178,0.55));
    }
}

@keyframes cardAppear{

    0%{
        opacity:0;

        transform:
        translateY(20px)
        scale(.94);

        filter:blur(12px);
    }

    100%{
        opacity:1;

        transform:
        translateY(0)
        scale(1);

        filter:blur(0);
    }
}

</style>
