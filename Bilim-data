        /* Навигация (Неоморфизм) */
        .nav {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .day-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 12px;
            background: var(--bg);
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
            color: #666;
        }

        .day-btn:active, .day-btn.active {
            box-shadow: var(--inner-shadow);
            color: #333;
            transform: scale(0.95);
        }

        /* Карточка расписания (Глассморфизм) */
        .schedule-card {
            width: 100%;
            max-width: 500px;
            background: var(--glass);
            backdrop-filter: blur(15px);
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.4);
            box-shadow: var(--shadow);
