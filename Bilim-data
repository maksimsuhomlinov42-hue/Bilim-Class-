<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BilimClass Premium Schedule</title>

<style>

/* =========================
   ОСНОВА
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html,body{

    width:100%;
    min-height:100vh;

    display:flex;
    justify-content:center;
    align-items:flex-start;

    overflow-x:hidden;

    font-family:
    'Segoe UI',
    system-ui,
    sans-serif;

    background:
    linear-gradient(
        180deg,
        #edf7f1,
        #f5fff8
    );

}

/* =========================
   PREMIUM GREEN
========================= */

:root{

    --premium-green:#7dffb2;
    --premium-green-soft:#dffff0;
    --premium-green-light:#c9ffe2;
    --premium-deep:#16a34a;

}

/* =========================
   КОНТЕЙНЕР
========================= */

.wave-wrapper{

    position:relative;

    width:95vw;

    margin:20px auto;

    padding:25px;

    perspective:1200px;

    display:flex;
    flex-direction:column;
    align-items:center;

}

/* =========================
   LIQUID GLASS BLOCK
========================= */

.liquid-flag-bg{

    position:absolute;

    inset:0;

    border-radius:34px;

    background:
    linear-gradient(
        145deg,
        rgba(220,255,235,0.38),
        rgba(125,255,178,0.12)
    );

    border:
    2px solid rgba(255,255,255,0.45);

    backdrop-filter:blur(24px);

    box-shadow:

    0 0 45px rgba(125,255,178,0.18),

    0 20px 40px rgba(34,197,94,0.12),

    inset 0 0 25px rgba(255,255,255,0.22),

    inset 0 -10px 25px rgba(0,0,0,0.04);

    animation:
    liquidMove 12s ease-in-out infinite alternate;

    z-index:1;
}

/* =========================
   GLOW
========================= */

.liquid-flag-bg::before{

    content:"";

    position:absolute;

    inset:-3px;

    border-radius:inherit;

    background:
    linear-gradient(
        135deg,
        rgba(125,255,178,0.30),
        rgba(255,255,255,0.08)
    );

    filter:blur(28px);

    opacity:0.9;

    z-index:-1;

    animation:
    premiumGlow 5s ease-in-out infinite;
}

/* =========================
   CONTENT
========================= */

.content-layer{

    position:relative;

    z-index:2;

    width:100%;

    display:flex;
    flex-direction:column;
    align-items:center;

    animation:
    fabricMove 9s ease-in-out infinite;
}

/* =========================
   САМОЛЁТ
========================= */

.airplane-container{

    position:relative;

    font-size:52px;

    margin-top:10px;
    margin-bottom:22px;

    user-select:none;

    color:white;

    backdrop-filter:blur(10px);

    filter:

    drop-shadow(
        0 0 18px rgba(125,255,178,0.45)
    )

    drop-shadow(
        0 0 30px rgba(125,255,178,0.25)
    );

    animation:
    airplaneFly 4s ease-in-out infinite alternate,
    airplaneFloat 7s ease-in-out infinite;
}

.airplane-container::before{

    content:"";

    position:absolute;

    inset:0;

    border-radius:50%;

    background:
    radial-gradient(
        circle at top left,
        rgba(255,255,255,0.55),
        transparent 55%
    );

    filter:blur(6px);

    opacity:0.8;

}

/* =========================
   КНОПКИ
========================= */

.neumorphic-controls,
.days-tabs-panel{

    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:12px;

    padding:12px 18px;

    border-radius:22px;

    margin-bottom:18px;

    background:
    linear-gradient(
        145deg,
        rgba(245,255,250,0.92),
        rgba(220,255,235,0.78)
    );

    backdrop-filter:blur(18px);

    box-shadow:

    0 8px 24px rgba(125,255,178,0.10),

    inset 0 0 12px rgba(255,255,255,0.22);

}

.days-tabs-panel{

    width:90%;
    max-width:620px;
}

/* =========================
   BUTTON
========================= */

.neu-btn{

    border:none;
    outline:none;

    cursor:pointer;

    padding:11px 18px;

    border-radius:15px;

    font-size:14px;
    font-weight:800;

    color:#15803d;

    background:
    linear-gradient(
        145deg,
        rgba(255,255,255,0.9),
        rgba(220,255,235,0.75)
    );

    box-shadow:

    5px 5px 12px rgba(0,0,0,0.06),

    inset 0 0 10px rgba(255,255,255,0.35);

    transition:
    all .25s ease;
}

.neu-btn:hover{

    color:#22c55e;

    transform:
    translateY(-2px)
    scale(1.03);

    box-shadow:

    0 0 20px rgba(125,255,178,0.18),

    0 6px 16px rgba(0,0,0,0.06);
}

.neu-btn.active-day{

    background:
    linear-gradient(
        145deg,
        rgba(210,255,225,0.95),
        rgba(180,255,210,0.75)
    );

    color:#16a34a;

    box-shadow:

    inset 0 0 12px rgba(255,255,255,0.35),

    0 0 18px rgba(125,255,178,0.22);
}

/* =========================
   WEEK BAR
========================= */

.current-week-bar{

    margin-bottom:25px;

    padding:10px 22px;

    border-radius:20px;

    font-size:16px;
    font-weight:800;

    color:#15803d;

    background:
    linear-gradient(
        145deg,
        rgba(245,255,250,0.92),
