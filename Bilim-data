<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimClass - Адаптивное Расписание</title>
    <style>
        /* БАЗОВЫЕ НАСТРОЙКИ ДЛЯ ВСЕГО ЭКРАНА */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background: transparent !important;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            box-sizing: border-box;
        }

        /* 🌊 ГЛАВНЫЙ КОНТЕЙНЕР-ФЛАГ (Адаптируется под ПК и Мобильные) */
        .wave-wrapper {
            position: relative;
            width: 95vw;
            margin: 20px auto;
            padding: 20px;
            box-sizing: border-box;
            perspective: 1000px; /* Глубина для 3D эффекта флага */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 🟢 ЖИДКИЙ ЗАДНИЙ ФОН БЕЗ ОСТРЫХ УГЛОВ */
        .liquid-flag-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.4), rgba(34, 197, 94, 0.2));
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            
            /* Скругление углов, создающее эффект капли */
            border-radius: 30px;
            border: 2.5px solid rgba(255, 255, 255, 0.6);
            
            box-shadow: 
                inset 0 0 30px rgba(255, 255, 255, 0.5),
                0 15px 35px rgba(34, 197, 94, 0.08);
            
            /* Медленная плавная анимация колыхания флага */
            animation: flagWaveAnimation 12s ease-in-out infinite alternate;
            z-index: 1;
        }

        /* 👑 СЛОЙ С КОНТЕНТОМ (ПОВЕРХ ФОНА) */
        .content-layer {
            position: relative;
            z-index: 2;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            /* Тоже колышется синхронно с каплей */
            animation: flagWaveAnimation 12s ease-in-out infinite alternate;
        }

        /* ✨ ЗАКРУГЛЕННЫЙ ЗАГОЛОВОК С ЗОЛОТЫМ СИЯНИЕМ */
        .shining-text {
            font-size: clamp(28px, 5vw, 52px); 
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: clamp(2px, 0.8vw, 6px);
            margin: 10px 0 25px 0;
            text-align: center;
            user-select: none;
            
            /* Золотой перелив */
            background: linear-gradient(
                to right, 
                #b45309 0%, 
                #f59e0b 25%, 
                #fef08a 50%, 
                #f59e0b 75%, 
                #b45309 100%
            );
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            
            filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.05));
            animation: goldShine 3s linear infinite;
        }

        /* 📅 АДАПТИВНАЯ СЕТКА ДЛЯ ДНЕЙ НЕДЕЛИ (Умный Grid) */
        .schedule-grid {
            display: grid;
            width: 100%;
            gap: 15px;
            /* На ПК автоматически создается 3 колонки, если место позволяет */
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            box-sizing: border-box;
            padding: 10px;
        }

        /* 📋 КАРТОЧКА ОДНОГО ДНЯ */
        .day-card {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 18px; /* Гладкие закругленные углы */
            padding: 15px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
            transition: transform 0.3s ease;
        }

        .day-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.6);
        }

        /* НАЗВАНИЕ ДНЯ НЕДЕЛИ */
        .day-title {
            font-size: 20px;
            font-weight: 700;
            color: #166534; /* Темно-зеленый минималистичный цвет */
            margin-top: 0;
            margin-bottom: 12px;
            border-bottom: 2px solid rgba(34, 197, 94, 0.3);
            padding-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* СПИСОК УРОКОВ */
        .lesson-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-size: 15px;
        }

        .lesson-item:last-child {
            border-bottom: none;
        }

        /* Время урока */
        .lesson-time {
            font-weight: 600;
            color: #64748b;
            font-size: 13px;
            background: rgba(255, 255, 255, 0.6);
            padding: 2px 6px;
            border-radius: 6px;
        }

        /* Название предмета */
        .lesson-name {
            font-weight: 500;
            color: #1e293b;
            text-align: right;
        }

        /* 🏴‍☠️ СИНХРОННАЯ АНИМАЦИЯ ВОЛНЫ ФЛАГА ДЛЯ ВСЕГО ИНТЕРФЕЙСА */
        @keyframes flagWaveAnimation {
            0% {
                border-radius: 30px 45px 35px 50px;
                transform: rotateX(3deg) rotateY(-3deg) skewX(-2deg) translateY(0px);
            }
            50% {
                border-radius: 40px 35px 45px 35px;
                transform: rotateX(0deg) rotateY(0deg) skewX(0deg) translateY(-4px);
            }
            100% {
                border-radius: 35px 50px 30px 45px;
                transform: rotateX(-3deg) rotateY(3deg) skewX(2deg) translateY(4px);
            }
        }

        /* Анимация золотого луча */
        @keyframes goldShine {
            0% { background-position: 200% center; }
            100% { background-position: 0% center; }
        }
    </style>
</head>
<body>

    <!-- Главная подстраивающаяся обертка -->
    <div class="wave-wrapper">
        
        <!-- Живой текучий задний фон флага -->
        <div class="liquid-flag-bg"></div>
        
        <!-- Контент расписания поверх фона -->
        <div class="content-layer">
            
            <!-- Огромная сияющая надпись -->
            <h1 class="shining-text">Bilim Class</h1>
            
            <!-- Сетка с днями недели -->
            <div class="schedule-grid">
                
                <!-- ПОНЕДЕЛЬНИК -->
                <div class="day-card">
                    <h2 class="day-title">Понедельник</h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">10:55</span><span class="lesson-name">Естествознание</span></li>
                    </ul>
                </div>

                <!-- ВТОРНИК -->
                <div class="day-card">
                    <h2 class="day-title">Вторник</h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Цифровая грамотность</span></li>
                    </ul>
                </div>

                <!-- СРЕДА -->
                <div class="day-card">
                    <h2 class="day-title">Среда</h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                    </ul>
                </div>

                <!-- ЧЕТВЕРГ -->
                <div class="day-card">
                    <h2 class="day-title">Четверг</h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Естествознание</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Художественный труд</span></li>
                    </ul>
                </div>

                <!-- ПЯТНИЦА -->
                <div class="day-card">
                    <h2 class="day-title">Пятница</h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Познание мира</span></li>
                    </ul>
                </div>

            </div>
        </div>

    </div>

</body>
</html>
