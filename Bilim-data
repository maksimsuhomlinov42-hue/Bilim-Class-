<style>
    /* Настройка фона, чтобы стекло было видно (нужен контраст) */
    .glass-scene {
        background: linear-gradient(135deg, #28cd41 0%, #000000 100%);
        padding: 100px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
    }

    /* ТОТ САМЫЙ КВАДРАТ С ЖИДКИМ СТЕКЛОМ */
    .liquid-square {
        width: 250px;
        height: 250px;
        position: relative;
        
        /* СЛОЙ 1: ОСНОВА (Размытие фона) */
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(40px) saturate(150%);
        -webkit-backdrop-filter: blur(40px);
        
        /* СЛОЙ 2: БЛИК (Тонкая рамка и мягкие углы) */
        border-radius: 50px; /* Твои любимые мягкие углы */
        border: 1px solid rgba(255, 255, 255, 0.4);
        
        /* СЛОЙ 3: ГЛЯНЕЦ (Внутренние и внешние тени для объема) */
        box-shadow: 
            0 25px 50px rgba(0, 0, 0, 0.3), /* Внешняя тень */
            inset 0 0 20px rgba(255, 255, 255, 0.2); /* Внутреннее свечение */
            
        display: flex;
        justify-content: center;
        align-items: center;
        transition: 0.5s ease;
    }

    /* Эффект при наведении — стекло "оживает" */
    .liquid-square:hover {
        transform: scale(1.05) rotate(2deg);
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.6);
    }

    .glass-text {
        color: white;
        font-family: 'SF Pro Display', sans-serif;
        font-weight: 200;
        font-size: 20px;
        letter-spacing: 2px;
        text-transform: uppercase;
    }
</style>

<div class="glass-scene">
    <div class="liquid-square">
        <span class="glass-text">LIQUID</span>
    </div>
</div>
