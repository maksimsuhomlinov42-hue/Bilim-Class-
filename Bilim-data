<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimClass - Расписание</title>
    <style>
        /* БАЗОВЫЕ НАСТРОЙКИ СТРАНИЦЫ */
        body {
            margin: 0;
            padding: 20px;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #0f172a, #1e1b4b, #2e1065);
            min-height: 100vh;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            box-sizing: border-box;
        }

        /* 🔮 ПРОФЕССИОНАЛЬНОЕ МАТОВОЕ СТЕКЛО (ГЛАССМОРФИЗМ) */
        .glass-panel {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 30px;
            width: 100%;
            max-width: 650px;
            box-shadow: 
                inset 1px 1px 2px rgba(255, 255, 255, 0.05),
                0 20px 50px rgba(0, 0, 0, 0.3);
            animation: panelAppear 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes panelAppear {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
                filter: blur(10px);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
                filter: blur(0);
            }
        }

        /* ВЕРХНИЙ ТУЛБАР */
        .toolbar {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 25px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            padding-bottom: 20px;
        }

        .toolbar-row {
            display: flex;
            gap: 15px;
            width: 100%;
        }

        .select-wrapper {
            flex: 1;
        }

        label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.4);
            margin-bottom: 6px;
            font-weight: 600;
        }

        select {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            appearance: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        select:focus {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .days-tabs {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding: 5px 2px;
        }

        .days-tabs::-webkit-scrollbar { height: 0px; }

        /* 💧 КНОПКИ-КАПЛИ С ЭФФЕКТОМ ЖИДКОГО СТЕКЛА */
        .tab-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 12px 18px;
            border-radius: 14px;
            color: rgba(255, 255, 255, 0.6);
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                        background 0.3s, border-color 0.3s, box-shadow 0.4s, color 0.3s;
            transform-origin: center bottom;
        }

        .tab-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.15);
        }

        /* Физическое сплющивание жидкого стекла при нажатии */
        .tab-btn:active {
            transform: scale(1.06, 0.88); 
            background: rgba(255, 255, 255, 0.01);
            border-color: rgba(255, 255, 255, 0.05);
            box-shadow: 
                inset 4px 4px 8px rgba(0, 0, 0, 0.5), 
                inset -4px -4px 8px rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.4);
            transition: transform 0.08s ease-out, box-shadow 0.08s ease-out;
        }

        /* Скрытый неоморфизм: мягкое вдавливание активной вкладки */
        .tab-btn.active {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.25);
            color: #fff;
            box-shadow: 
                inset 1px 1px 2px rgba(255, 255, 255, 0.2),
                0 4px 12px rgba(0, 0, 0, 0.15);
        }

        /* 🌪️ ЭФФЕКТ СКРЕТЧИНГА ПРИ ОБНОВЛЕНИИ */
        .scratch-effect {
            animation: scratch 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes scratch {
            0% {
                opacity: 0;
                transform: scale(0.95) translateY(15px);
                filter: blur(6px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
                filter: blur(0);
            }
        }

        /* БЛОК С РАСПИСАНИЕМ */
        .schedule-content {
            margin-top: 20px;
        }

        .schedule-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .schedule-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 600;
        }

        .lessons-count {
            font-size: 12px;
            background: rgba(255, 255, 255, 0.06);
            padding: 4px 12px;
            border-radius: 20px;
            color: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .lessons-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .lesson-item {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.01);
            border: 1px solid rgba(255, 255, 255, 0.03);
            padding: 14px 18px;
            border-radius: 14px;
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s;
        }

        .lesson-item:hover {
            transform: translateX(6px) scale(1.01);
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(255, 255, 255, 0.08);
        }

        .lesson-num {
            font-size: 14px;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.25);
            width: 30px;
        }

        .lesson-info {
            flex: 1;
        }

        .lesson-name {
            font-weight: 500;
            font-size: 15px;
            margin-bottom: 2px;
        }

        .lesson-time {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.35);
        }
    </style>
</head>
<body>

    <div class="glass-panel">
        <div class="toolbar">
            <!-- Первая строчка: Выбор года до 2027 -->
            <div class="toolbar-row">
                <div class="select-wrapper">
                    <label>Учебный Год</label>
                    <select id="yearSelect" onchange="triggerScratch()">
                        <option value="2026">2025 - 2026 год</option>
                        <option value="2027" selected>2026 - 2027 год</option>
                    </select>
                </div>
                
                <!-- Выбор недели на год (34 недели) -->
                <div class="select-wrapper">
                    <label>Учебная неделя</label>
                    <select id="weekSelect" onchange="triggerScratch()">
                        <!-- Генерируется через скрипт ниже -->
                    </select>
                </div>
            </div>

            <!-- Вторая строчка: Дни с Понедельника по Субботу -->
            <div>
                <label>День недели</label>
                <div class="days-tabs" id="daysContainer">
                    <button class="tab-btn active" onclick="changeDay(0, this)">Пон</button>
                    <button class="tab-btn" onclick="changeDay(1, this)">Вто</button>
                    <button class="tab-btn" onclick="changeDay(2, this)">Сре</button>
                    <button class="tab-btn" onclick="changeDay(3, this)">Чет</button>
                    <button class="tab-btn" onclick="changeDay(4, this)">Пят</button>
                    <button class="tab-btn" onclick="changeDay(5, this)">Суб</button>
                </div>
            </div>
        </div>

        <!-- Контент с уроками -->
        <div class="schedule-content scratch-effect" id="scheduleBox">
            <div class="schedule-header">
                <h2 id="currentDayTitle">Понедельник</h2>
                <div class="lessons-count" id="lessonsCount">6 уроков</div>
            </div>
            <div class="lessons-list" id="lessonsList">
                <!-- Рендерится из JS -->
            </div>
        </div>
    </div>

    <script>
        // Данные: Пн и Ср по 6 уроков, остальные по 5
        const lessonsData = {
            0: { name: "Понедельник", count: 6, list: ["Математика", "Казахский язык", "Русский язык", "Естествознание", "Цифровая грамотность", "Литературное чтение"] },
            1: { name: "Вторник", count: 5, list: ["Английский язык", "Математика", "Познание мира", "Художественный труд", "Физическая культура"] },
            2: { name: "Среда", count: 6, list: ["Казахский язык", "Математика", "Русский язык", "Музыка", "Литературное чтение", "Самопознание"] },
            3: { name: "Четверг", count: 5, list: ["Математика", "Русский язык", "Естествознание", "Казахский язык", "Физическая культура"] },
            4: { name: "Пятница", count: 5, list: ["Информатика", "Английский язык", "Литературное чтение", "Математика", "Физическая культура"] },
            5: { name: "Суббота", count: 5, list: ["Олимпиада", "Проектная деятельность", "Шахматы", "Логика", "Робототехника"] }
        };

        const timeSlots = ["08:00 - 08:45", "08:55 - 09:40", "09:55 - 10:40", "10:55 - 11:40", "11:55 - 12:40", "12:50 - 13:35"];

        // Наполнение селектора недель (от 1 до 34)
        const weekSelect = document.getElementById('weekSelect');
        for (let i = 1; i <= 34; i++) {
            let opt = document.createElement('option');
            opt.value = i;
            opt.innerText = `Неделя ${i}`;
            if(i === 1) opt.selected = true;
            weekSelect.appendChild(opt);
        }

        // Вывод списка уроков на экран
        function renderSchedule(dayIdx) {
            const dayData = lessonsData[dayIdx];
            document.getElementById('currentDayTitle').innerText = dayData.name;
            document.getElementById('lessonsCount').innerText = `${dayData.count} уроков`;

            const listContainer = document.getElementById('lessonsList');
            listContainer.innerHTML = '';

            for (let i = 0; i < dayData.count; i++) {
                const item = document.createElement('div');
                item.className = 'lesson-item';
                item.style.animationDelay = `${i * 0.04}s`;
                item.innerHTML = `
                    <div class="lesson-num">${i + 1}</div>
                    <div class="lesson-info">
                        <div class="lesson-name">${dayData.list[i]}</div>
                        <div class="lesson-time">${timeSlots[i]}</div>
                    </div>
                `;
                listContainer.appendChild(item);
            }
        }

        // Клик по дням недели
        function changeDay(idx, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderSchedule(idx);
            triggerScratch();
        }

        // Запуск скретчинг-эффекта появления
        function triggerScratch() {
            const box = document.getElementById('scheduleBox');
            box.classList.remove('scratch-effect');
            void box.offsetWidth; 
            box.classList.add('scratch-effect');
        }

        // Первичный запуск при старте страницы
        renderSchedule(0);
    </script>
</body>
</html>
