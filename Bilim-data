    inset 0 0 18px rgba(255,255,255,0.22),

    8px 8px 20px rgba(0,0,0,0.05);

    animation:
    cardAppear .45s cubic-bezier(.17,.84,.44,1);
}

/* =========================
   TODAY
========================= */

.day-card.today{

    border:
    2px solid rgba(125,255,178,0.55);

    box-shadow:

    0 0 30px rgba(125,255,178,0.25),

    0 10px 30px rgba(125,255,178,0.18),

    inset 0 0 20px rgba(255,255,255,0.25);
}

/* =========================
   TITLE
========================= */

.day-title{

    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:18px;

    padding-bottom:10px;

    border-bottom:
