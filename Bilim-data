<style>
    /* 1. БАЗОВЫЕ НАСТРОЙКИ iOS 26 */
    :root {
        --ios-green: #28cd41;
        --ios-white: #ffffff;
        --glass-bg: rgba(255, 255, 255, 0.7);
        --radius: 35px; /* Мягкие углы iOS */
    }

    .bilim-app {
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
        min-height: 500px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        color: #000;
    }

    /* 2. МНОГОСЛОЙНОЕ ЖИДКОЕ СТЕКЛО */
    .liquid-glass {
        position: relative;
        background: var(--glass-bg);
        /* Слой 1: Размытие */
        backdrop-filter: blur(35px) saturate(200%);
        -webkit-backdrop-filter: blur(35px);
        
        /* Слой 2: Граница и форма */
        border-radius: var(--radius);
        border: 1px solid rgba(255, 255, 255, 0.4);
        
        /* Слой 3: Объемная тень */
        box-shadow: 
            0 15px 35px rgba(0,0,0,0.05),
            inset 0 0 15px rgba(255,255,255,0.5);
        
        padding: 20px;
        overflow: hidden;
    }

    /* Эффект глянцевого блика поверх стекла */
    .liquid-glass::before {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
        pointer-events: none;
    }

    /* 3. ДИЗАЙН КНОПОК И РАСПИСАНИЯ */
    .ios-header {
        font-size: 28px;
        font-weight: 700;
        color: #1d1d1f;
        margin-bottom: 10px;
    }

    .schedule-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px;
        background: rgba(255, 255, 255, 0.4);
        margin-bottom: 10px;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .status-dot {
        width: 10px;
        height: 10px;
        background: var(--ios-green);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--ios-green);
    }

    .ios-button {
        background: var(--ios-green);
        color: white;
        border: none;
        padding: 15px 25px;
        border-radius: 20px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.2s;
        box-shadow: 0 8px 20px rgba(40, 205, 65, 0.3);
    }

    .ios-button:active {
        transform: scale(0.95);
    }

    /* 4. ТАЙМЕР */
    .timer-display {
        font-size: 48px;
        font-weight: 200; /* Тонкий шрифт в стиле iOS */
        text-align: center;
        margin: 20px 0;
        letter-spacing: -1px;
    }
</style>

<div class="bilim-app">
    <div class="liquid-glass">
        <div class="ios-header">BilimClass</div>
        
        <div class="timer-display" id="main-timer">00:00:00</div>

        <div id="schedule-list">
            <div class="schedule-item">
                <div>
                    <strong>Информатика</strong><br>
                    <small>09:00 - 09:45</small>
                </div>
                <div class="status-dot"></div>
            </div>
            
            <div class="schedule-item">
                <div>
                    <strong>Робототехника</strong><br>
                    <small>10:00 - 10:45</small>
                </div>
                <div style="opacity: 0.3" class="status-dot"></div>
            </div>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 20px;">
            <button class="ios-button" onclick="alert('Домашнее задание')">Задания</button>
            <button class="ios-button" style="background: white; color: var(--ios-green); border: 1px solid var(--ios-green);">Чат</button>
        </div>
    </div>
</div>

<script>
    // Оживление таймера
    function updateTime() {
        const now = new Date();
        document.getElementById('main-timer').innerText = now.toLocaleTimeString('ru-RU');
    }
    setInterval(updateTime, 1000);
    updateTime();
</script>
