<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimClass - Ультра 3D Неоморфное Расписание</title>
    <style>
        /* БАЗОВОЕ ХАЙ-ТЕК ПРОСТРАНСТВО */
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background: #eef2f3 !important; /* Мягкая светлая подложка для идеального неоморфизма */
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            box-sizing: border-box;
        }

        /* 🌊 ГЛОБАЛЬНЫЙ 3D КОНТЕЙНЕР С ЭФФЕКТОМ ГЛУБИНЫ */
        .wave-wrapper {
            position: relative;
            width: 96vw;
            margin: 30px auto;
            padding: 30px;
            box-sizing: border-box;
            perspective: 1500px; /* Усиленная 3D перспектива для крутого наклона */
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 🔥 КИБЕРНЕТИЧЕСКАЯ ЖИДКАЯ КАПЛЯ НА ЗАДНЕМ ФОНЕ */
        .liquid-flag-bg {
            position: absolute;
            top: -5%;
            left: -5%;
            width: 110%;
            height: 110%;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.35), rgba(34, 197, 94, 0.15), rgba(6, 182, 212, 0.2));
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            
            /* Жидкая постоянно меняющаяся форма */
            border-radius: 40% 60% 35% 65% / 60% 40% 60% 40%;
            border: 3px solid rgba(255, 255, 255, 0.7);
            
            /* Мощнейшее футуристическое свечение */
            box-shadow: 
                inset 0 0 50px rgba(255, 255, 255, 0.6),
                0 25px 60px rgba(34, 197, 94, 0.15),
                0 -25px 60px rgba(6, 182, 212, 0.1);
            
            /* Медленная лавовая анимация капли */
            animation: lavaFlow 16s ease-in-out infinite alternate;
            z-index: 1;
        }

        /* 👑 СЛОЙ КОНТЕНТА, ПЛЫВУЩИЙ В 3D ПРОСТРАНСТВЕ */
        .content-layer {
            position: relative;
            z-index: 2;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            transform-style: preserve-3d;
            animation: flag3DWave 10s ease-in-out infinite alternate;
        }

        /* ✨ ОГРОМНЫЙ ЗАКРУГЛЕННЫЙ ТЕКСТ С ДВОЙНЫМ СИЯНИЕМ */
        .shining-text {
            font-size: clamp(32px, 6vw, 58px); 
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: clamp(3px, 1.2vw, 8px);
            margin: 10px 0 5px 0;
            text-align: center;
            user-select: none;
            
            /* Жидкое переливающееся золото */
            background: linear-gradient(to right, #b45309 0%, #f59e0b 25%, #fef08a 50%, #f59e0b 75%, #b45309 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            
            filter: drop-shadow(0 5px 10px rgba(180, 83, 9, 0.15));
            animation: goldShine 2.5s linear infinite;
            transform: translateZ(50px); /* Выталкивает текст вперед на 50px над интерфейсом! */
        }

        /* ПЛАШКА ТЕКУЩЕЙ НЕДЕЛИ С НЕОМОРФНЫМ ВДАВЛИВАНИЕМ */
        .current-week-bar {
            font-size: clamp(14px, 2.2vw, 19px);
            font-weight: 700;
            color: #15803d;
            margin-bottom: 35px;
            
            /* Эффект вогнутого неоморфизма (Inverted Neomorphism) */
            background: #eef2f3;
            padding: 8px 22px;
            border-radius: 25px;
            box-shadow: 
                inset 3px 3px 6px rgba(0, 0, 0, 0.05), 
                inset -3px -3px 6px rgba(255, 255, 255, 0.9);
            transform: translateZ(30px);
        }

        /* 📅 УМНАЯ АДАПТИВНАЯ СЕТКА КАРТОЧЕК */
        .schedule-grid {
            display: grid;
            width: 100%;
            gap: 25px;
            grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
            box-sizing: border-box;
            padding: 15px;
            transform-style: preserve-3d;
        }

        /* 📋 КАРТОЧКА: ПЕРЕСЕЧЕНИЕ НЕОМОРФИЗМА И МАТОВОГО СТЕКЛА */
        .day-card {
            background: rgba(238, 242, 243, 0.6);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border-radius: 24px; /* Максимально закругленные грани */
            padding: 22px;
            box-sizing: border-box;
            border: 1px solid rgba(255, 255, 255, 0.6);
            
            /* Выпуклый объемный Неоморфизм */
            box-shadow: 
                9px 9px 20px rgba(166, 180, 184, 0.7), 
                -9px -9px 20px rgba(255, 255, 255, 0.9),
                inset 1px 1px 0px rgba(255, 255, 255, 0.5);
            
            /* Настройка плавности для эффекта скретчинга */
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                        box-shadow 0.4s ease, 
                        background-color 0.4s ease;
            transform-style: preserve-3d;
            transform: translateZ(10px);
        }

        /* 🌪️ ЭФФЕКТ СКРЕТЧИНГА И 3D НАКЛОНА ПРИ НАВЕДЕНИИ (РЕЗИНОВАЯ ПРУЖИНА) */
        .day-card:hover {
            background: rgba(255, 255, 255, 0.85);
            
            /* Карточка вытягивается, пружинит и скручивается в 3D */
            transform: scale(1.05) rotateX(8deg) rotateY(-8deg) translateZ(40px);
            
            /* Тень становится глубже, усиливая эффект отрыва от экрана */
            box-shadow: 
                15px 20px 35px rgba(166, 180, 184, 0.6), 
                -15px -15px 35px rgba(255, 255, 255, 1);
        }

        /* 🔥 КАРТОЧКА СЕГОДНЯШНЕГО ДНЯ С НЕОНОВЫМ ДРАЙВОМ */
        .day-card.today {
            background: rgba(255, 255, 255, 0.85);
            border: 2px solid #22c55e;
            /* Неоморфный объем + Изумрудное неоновое свечение */
            box-shadow: 
                0 0 25px rgba(34, 197, 94, 0.4),
                9px 9px 22px rgba(166, 180, 184, 0.5), 
                -9px -9px 22px rgba(255, 255, 255, 0.9);
            transform: translateZ(25px);
        }
        .day-card.today:hover {
            transform: scale(1.06) rotateX(8deg) rotateY(-8deg) translateZ(55px);
            box-shadow: 
                0 0 35px rgba(34, 197, 94, 0.6),
                15px 20px 35px rgba(166, 180, 184, 0.5);
        }
        .day-card.today .day-title {
            color: #22c55e;
            text-shadow: 0 0 8px rgba(34, 197, 94, 0.3);
        }

        /* КРУТЫЕ СТИЛИ ВНУТРИ КАРТОЧКИ */
        .day-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 19px;
            font-weight: 800;
            color: #166534;
            margin-top: 0;
            margin-bottom: 15px;
            border-bottom: 2px dashed rgba(34, 197, 94, 0.25);
            padding-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .day-date {
            font-size: 13px;
            font-weight: 700;
            background: rgba(34, 197, 94, 0.12);
            padding: 3px 9px;
            border-radius: 12px;
            color: #15803d;
        }

        .lesson-list { list-style: none; padding: 0; margin: 0; }
        
        /* СТРОКА УРОКА С ВНУТРЕННИМ НЕОМОРФНЫМ ОБЪЕМОМ */
        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 12px;
            margin-bottom: 8px;
            border-radius: 14px;
            background: rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.4);
            transition: all 0.2s ease;
        }
        .lesson-item:hover {
            background: #ffffff;
            transform: translateZ(15px); /* Текст урока выплывает вперед при ховере */
        }
        .lesson-item:last-child { margin-bottom: 0; }
        
        .lesson-time {
            font-weight: 700;
            color: #475569;
            font-size: 12px;
            background: #eef2f3;
            padding: 3px 8px;
            border-radius: 8px;
            box-shadow: inset 1px 1px 3px rgba(0,0,0,0.05), 1px 1px 2px rgba(255,255,255,0.8);
        }
        .lesson-name { font-weight: 600; color: #1e293b; text-align: right; font-size: 14px; }

        /* 🏴‍☠️ КОРРЕКТНЫЕ И ПЛАВНЫЕ 3D АНИМАЦИИ */
        @keyframes lavaFlow {
            0% { border-radius: 40% 60% 35% 65% / 60% 40% 60% 40%; transform: rotate(0deg) scale(1); }
            50% { border-radius: 55% 45% 55% 45% / 45% 55% 40% 60%; transform: rotate(2deg) scale(1.02); }
            100% { border-radius: 38% 62% 43% 57% / 50% 42% 58% 50%; transform: rotate(-2deg) scale(0.98); }
        }

        @keyframes flag3DWave {
            0% { transform: rotateX(4deg) rotateY(-4deg) rotateZ(-0.5deg) translateY(0px); }
            50% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0.5deg) translateY(-5px); }
            100% { transform: rotateX(-4deg) rotateY(4deg) rotateZ(-0.5deg) translateY(5px); }
        }

        @keyframes goldShine {
            0% { background-position: 200% center; }
            100% { background-position: 0% center; }
        }
    </style>
</head>
<body>

    <div class="wave-wrapper">
        <!-- Анимированная жидкая неоновая лава -->
        <div class="liquid-flag-bg"></div>
        
        <!-- Основной контент-слой с поддержкой 3D -->
        <div class="content-layer">
            
            <h1 class="shining-text">Bilim Class</h1>
            <div class="current-week-bar" id="week-range">Синхронизация времени...</div>
            
            <div class="schedule-grid">
                
                <!-- ПН -->
                <div class="day-card" id="day-1">
                    <h2 class="day-title">Пн <span class="day-date" id="date-1"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">10:55</span><span class="lesson-name">Естествознание</span></li>
                    </ul>
                </div>

                <!-- ВТ -->
                <div class="day-card" id="day-2">
                    <h2 class="day-title">Вт <span class="day-date" id="date-2"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Цифровая грамотность</span></li>
                    </ul>
                </div>

                <!-- СР -->
                <div class="day-card" id="day-3">
                    <h2 class="day-title">Ср <span class="day-date" id="date-3"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                    </ul>
                </div>

                <!-- ЧТ -->
                <div class="day-card" id="day-4">
                    <h2 class="day-title">Чт <span class="day-date" id="date-4"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Естествознание</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Художественный труд</span></li>
                    </ul>
                </div>

                <!-- ПТ -->
                <div class="day-card" id="day-5">
                    <h2 class="day-title">Пт <span class="day-date" id="date-5"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Познание мира</span></li>
                    </ul>
                </div>

                <!-- СБ -->
                <div class="day-card" id="day-6">
                    <h2 class="day-title">Сб <span class="day-date" id="date-6"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">09:00</span><span class="lesson-name">Самоподготовка</span></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- 🧠 АВТОМАТИЧЕСКИЙ СЛЕДЯЩИЙ КАЛЕНДАРЬ -->
    <script>
        function updateWeekSchedule() {
            const now = new Date();
            const currentDay = now.getDay();
            
            const distanceToMonday = currentDay === 0 ? -6 : 1 - currentDay;
            const monday = new Date(now);
            monday.setDate(now.getDate() + distanceToMonday);

            const options = { day: 'numeric', month: 'short' };
            let mondayStr = "";
            let saturdayStr = "";

            for (let i = 1; i <= 6; i++) {
                const dayDate = new Date(monday);
                dayDate.setDate(monday.getDate() + (i - 1));
                
                const formattedDate = dayDate.toLocaleDateString('ru-RU', options);
                document.getElementById(`date-${i}`).innerText = formattedDate;

                if (i === 1) mondayStr = dayDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
                if (i === 6) saturdayStr = dayDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });

                if (now.getDate() === dayDate.getDate() && now.getMonth() === dayDate.getMonth() && now.getFullYear() === dayDate.getFullYear()) {
                    document.getElementById(`day-${i}`).classList.add('today');
                }
            }

            document.getElementById('week-range').innerText = `Неделя: ${mondayStr} — ${saturdayStr}`;
        }

        updateWeekSchedule();
    </script>
</body>
</html>
