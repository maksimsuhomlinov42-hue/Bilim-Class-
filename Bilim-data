<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimClass - Расписание</title>
    <style>
        /* БАЗОВЫЕ НАСТРОЙКИ — ПОЛНАЯ ПРОЗРАЧНОСТЬ */
        body {
            margin: 0;
            padding: 10px;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: transparent !important; /* Убран любой задний фон */
            color: #1e293b; /* Тёмный текст для светлого режима */
            box-sizing: border-box;
        }

        /* 🔮 СВЕТЛОЕ МАТОВОЕ СТЕКЛО (ЧИСТЫЙ ГЛАССМОРФИЗМ) */
        .glass-panel {
            background: rgba(255, 255, 255, 0.4); /* Светлое прозрачное стекло */
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            padding: 20px;
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            box-shadow: 
                inset 1px 1px 3px rgba(255, 255, 255, 0.8),
                0 10px 30px rgba(0, 0, 0, 0.04);
            animation: panelAppear 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes panelAppear {
            0% {
                opacity: 0;
                transform: translateY(20px) scale(0.98);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ТУЛБАР */
        .toolbar {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            padding-bottom: 15px;
        }

        .toolbar-row {
            display: flex;
            gap: 12px;
            width: 100%;
        }

        .select-wrapper {
            flex: 1;
        }

        label {
            display: block;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            margin-bottom: 4px;
            font-weight: 600;
        }

        select {
            width: 100%;
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 10px;
            color: #1e293b;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            appearance: none;
            transition: all 0.2s ease;
        }

        select:focus {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(0, 0, 0, 0.2);
        }

        .days-tabs {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding: 4px 2px;
        }
        .days-tabs::-webkit-scrollbar { height: 0px; }

        /* 💧 КНОПКИ С ЭФФЕКТОМ ЖИДКОГО СТЕКЛА */
        .tab-btn {
            flex: 1;
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(0, 0, 0, 0.06);
            padding: 10px 0;
            border-radius: 10px;
            color: #64748b;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            text-align: center;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                        background 0.3s, border-color 0.3s, box-shadow 0.4s, color 0.3s;
            transform-origin: center bottom;
        }

        .tab-btn:hover {
            color: #1e293b;
            background: rgba(255, 255, 255, 0.7);
            border-color: rgba(0, 0, 0, 0.12);
        }

        /* Надавливание и всплющивание (Эффект жидкости при клике) */
        .tab-btn:active {
            transform: scale(1.08, 0.85); /* Сплющивание по вертикали, расширение по бокам */
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 
                inset 2px 2px 5px rgba(0, 0, 0, 0.08), 
                inset -2px -2px 5px rgba(255, 255, 255, 0.6);
            transition: transform 0.06s ease-out;
        }

        /* Активная вкладка (Едва заметный, но ощутимый неоморфизм) */
        .tab-btn.active {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(0, 0, 0, 0.15);
            color: #0f172a;
            box-shadow: 
                inset 1px 1px 2px rgba(255, 255, 255, 1),
                0 3px 8px rgba(0, 0, 0, 0.05);
        }

        /* 🌪️ АНИМАЦИЯ СКРЕТЧИНГА (ПЛАВНОЕ ВЫСКАБЛИВАНИЕ) */
        .scratch-effect {
            animation: scratch 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }

        @keyframes scratch {
            0% {
                opacity: 0;
                transform: scale(0.96) translateY(12px);
                filter: blur(5px);
            }
            100% {
                opacity: 1;
                transform: scale(1) translateY(0);
                filter: blur(0);
            }
        }

        /* КОНТЕНТ РАСПИСАНИЯ */
        .schedule-content {
            margin-top: 15px;
        }

        .schedule-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .schedule-header h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: #0f172a;
        }

        .lessons-count {
            font-size: 11px;
            background: rgba(0, 0, 0, 0.05);
            padding: 3px 10px;
            border-radius: 20px;
            color: #475569;
            font-weight: 500;
        }

        .lessons-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .lesson-item {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.5);
            padding: 12px 16px;
            border-radius: 12px;
            transition: transform 0.2s ease, background 0.2s;
        }

        .lesson-item:hover {
            transform: translateX(4px);
            background: rgba(255, 255, 255, 0.6);
        }

        .lesson-num {
            font-size: 13px;
            font-weight: 700;
            color: #94a3b8;
            width: 25px;
        }

        .lesson-info {
            flex: 1;
        }

        .lesson-name {
            font-weight: 500;
            font-size: 14px;
            color: #1e293b;
            margin-bottom: 1px;
        }

        .lesson-time {
            font-size: 11px;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="glass-panel">
        <div class="toolbar">
            <div class="toolbar-row">
                <!-- Год до 2027 -->
                <div class="select-wrapper">
                    <label>Учебный Год</label>
                    <select id="yearSelect" onchange="triggerScratch()">
                        <option value="2026">2025 - 2026 год</option>
                        <option value="2027" selected>2026 - 2027 год</option>
                    </select>
                </div>
                
                <!-- Недели -->
                <div class="select-wrapper">
                    <label>Учебная неделя</label>
                    <select id="weekSelect" onchange="triggerScratch()">
                        <!-- Авто-генерация недель через JS -->
                    </select>
                </div>
            </div>

            <!-- Дни недели строго в нужном формате: ПН ВТ СР ЧТ ПТ СБ -->
            <div>
                <label>День недели</label>
                <div class="days-tabs" id="daysContainer">
                    <button class="tab-btn active" onclick="changeDay(0, this)">ПН</button>
                    <button class="tab-btn" onclick="changeDay(1, this)">ВТ</button>
                    <button class="tab-btn" onclick="changeDay(2, this)">СР</button>
                    <button class="tab-btn" onclick="changeDay(3, this)">ЧТ</button>
                    <button class="tab-btn" onclick="changeDay(4, this)">ПТ</button>
                    <button class="tab-btn" onclick="changeDay(5, this)">СБ</button>
                </div>
            </div>
        </div>

        <!-- Сетка уроков -->
        <div class="schedule-content scratch-effect" id="scheduleBox">
            <div class="schedule-header">
                <h2 id="currentDayTitle">Понедельник</h2>
                <div class="lessons-count" id="lessonsCount">6 уроков</div>
            </div>
            <div class="lessons-list" id="lessonsList">
                <!-- Сюда инжектируются уроки -->
            </div>
        </div>
    </div>

    <script>
        // Данные уроков (Пн и Ср по 6 уроков, остальные по 5)
        const lessonsData = {
            0: { name: "Понедельник", count: 6, list: ["Математика", "Казахский язык", "Русский язык", "Естествознание", "Цифровая грамотность", "Литературное чтение"] },
            1: { name: "Вторник", count: 5, list: ["Английский язык", "Математика", "Познание мира", "Художественный труд", "Физическая культура"] },
            2: { name: "Среда", count: 6, list: ["Казахский язык", "Математика", "Русский язык", "Музыка", "Литературное чтение", "Самопознание"] },
            3: { name: "Четверг", count: 5, list: ["Математика", "Русский язык", "Естествознание", "Казахский язык", "Физическая культура"] },
            4: { name: "Пятница", count: 5, list: ["Информатика", "Английский язык", "Литературное чтение", "Математика", "Физическая культура"] },
            5: { name: "Суббота", count: 5, list: ["Олимпиада", "Проектная деятельность", "Шахматы", "Логика", "Робототехника"] }
        };

        const timeSlots = ["08:00 - 08:45", "08:55 - 09:40", "09:55 - 10:40", "10:55 - 11:40", "11:55 - 12:40", "12:50 - 13:35"];

        // Наполнение списка недель (1-34)
        const weekSelect = document.getElementById('weekSelect');
        for (let i = 1; i <= 34; i++) {
            let opt = document.createElement('option');
            opt.value = i;
            opt.innerText = `Неделя ${i}`;
            if(i === 1) opt.selected = true;
            weekSelect.appendChild(opt);
        }

        // Рендеринг данных на страницу
        function renderSchedule(dayIdx) {
            const dayData = lessonsData[dayIdx];
            document.getElementById('currentDayTitle').innerText = dayData.name;
            document.getElementById('lessonsCount').innerText = `${dayData.count} уроков`;

            const listContainer = document.getElementById('lessonsList');
            listContainer.innerHTML = '';

            for (let i = 0; i < dayData.count; i++) {
                const item = document.createElement('div');
                item.className = 'lesson-item';
                item.innerHTML = `
                    <div class="lesson-num">${i + 1}</div>
                    <div class="lesson-info">
                        <div class="lesson-name">${dayData.list[i]}</div>
                        <div class="lesson-time">${timeSlots[i]}</div>
                    </div>
                `;
                listContainer.appendChild(item);
            }
        }

        // Клик на табы дней недели
        function changeDay(idx, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            renderSchedule(idx);
            triggerScratch();
        }

        // Запуск скретчинг-эффекта
        function triggerScratch() {
            const box = document.getElementById('scheduleBox');
            box.classList.remove('scratch-effect');
            void box.offsetWidth; // Магический сброс анимации в браузере
            box.classList.add('scratch-effect');
        }

        // Старт
        renderSchedule(0);
    </script>
</body>
</html>
