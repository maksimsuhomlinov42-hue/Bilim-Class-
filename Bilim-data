<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimClass - Умное Расписание с Датами</title>
    <style>
        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            background: transparent !important;
            overflow-x: hidden;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            box-sizing: border-box;
        }

        /* 🌊 АДАПТИВНЫЙ КОНТЕЙНЕР-ФЛАГ */
        .wave-wrapper {
            position: relative;
            width: 95vw;
            margin: 20px auto;
            padding: 20px;
            box-sizing: border-box;
            perspective: 1000px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* 🟢 ЖИДКИЙ ЗАДНИЙ ФОН */
        .liquid-flag-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(74, 222, 128, 0.4), rgba(34, 197, 94, 0.2));
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            border-radius: 30px;
            border: 2.5px solid rgba(255, 255, 255, 0.6);
            box-shadow: 
                inset 0 0 30px rgba(255, 255, 255, 0.5),
                0 15px 35px rgba(34, 197, 94, 0.08);
            animation: flagWaveAnimation 12s ease-in-out infinite alternate;
            z-index: 1;
        }

        /* 👑 СЛОЙ КОНТЕНТА */
        .content-layer {
            position: relative;
            z-index: 2;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            animation: flagWaveAnimation 12s ease-in-out infinite alternate;
        }

        /* ✨ ЗАКРУГЛЕННЫЙ ЗАГОЛОВОК С ЗОЛОТЫМ СИЯНИЕМ */
        .shining-text {
            font-size: clamp(26px, 4.5vw, 48px); 
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: clamp(2px, 0.8vw, 6px);
            margin: 10px 0 5px 0;
            text-align: center;
            user-select: none;
            background: linear-gradient(to right, #b45309 0%, #f59e0b 25%, #fef08a 50%, #f59e0b 75%, #b45309 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.05));
            animation: goldShine 3s linear infinite;
        }

        /* ДИАПАЗОН ТЕКУЩЕЙ НЕДЕЛИ ПОД ЗАГОЛОВКОМ */
        .current-week-bar {
            font-size: clamp(14px, 2vw, 18px);
            font-weight: 600;
            color: #15803d;
            margin-bottom: 25px;
            background: rgba(255, 255, 255, 0.5);
            padding: 5px 15px;
            border-radius: 20px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

        /* 📅 АДАПТИВНАЯ СЕТКА (Умный Grid) */
        .schedule-grid {
            display: grid;
            width: 100%;
            gap: 15px;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            box-sizing: border-box;
            padding: 10px;
        }

        /* 📋 КАРТОЧКА ДНЯ */
        .day-card {
            background: rgba(255, 255, 255, 0.45);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border-radius: 18px;
            padding: 15px;
            border: 1.5px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
            transition: all 0.3s ease;
        }

        .day-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.6);
        }

        /* 🔥 СТИЛЬ ДЛЯ ТЕКУЩЕГО ДНЯ (ПОДДСВЕТКА) */
        .day-card.today {
            background: rgba(255, 255, 255, 0.75);
            border: 2px solid #22c55e;
            box-shadow: 0 0 15px rgba(34, 197, 94, 0.3);
        }
        .day-card.today .day-title {
            color: #22c55e;
        }

        /* НАЗВАНИЕ ДНЯ + ДАТА */
        .day-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 18px;
            font-weight: 700;
            color: #166534;
            margin-top: 0;
            margin-bottom: 12px;
            border-bottom: 2px solid rgba(34, 197, 94, 0.2);
            padding-bottom: 5px;
            text-transform: uppercase;
        }

        .day-date {
            font-size: 14px;
            font-weight: 600;
            opacity: 0.8;
            text-transform: none;
        }

        /* СПИСОК УРОКОВ */
        .lesson-list { list-style: none; padding: 0; margin: 0; }
        .lesson-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            font-size: 15px;
        }
        .lesson-item:last-child { border-bottom: none; }
        .lesson-time {
            font-weight: 600;
            color: #64748b;
            font-size: 13px;
            background: rgba(255, 255, 255, 0.6);
            padding: 2px 6px;
            border-radius: 6px;
        }
        .lesson-name { font-weight: 500; color: #1e293b; text-align: right; }

        /* АНИМАЦИИ */
        @keyframes flagWaveAnimation {
            0% { border-radius: 30px 45px 35px 50px; transform: rotateX(3deg) rotateY(-3deg) skewX(-2deg) translateY(0px); }
            50% { border-radius: 40px 35px 45px 35px; transform: rotateX(0deg) rotateY(0deg) skewX(0deg) translateY(-4px); }
            100% { border-radius: 35px 50px 30px 45px; transform: rotateX(-3deg) rotateY(3deg) skewX(2deg) translateY(4px); }
        }
        @keyframes goldShine { 0% { background-position: 200% center; } 100% { background-position: 0% center; } }
    </style>
</head>
<body>

    <div class="wave-wrapper">
        <div class="liquid-flag-bg"></div>
        
        <div class="content-layer">
            <h1 class="shining-text">Bilim Class</h1>
            <!-- Тут JS напишет общий диапазон недели -->
            <div class="current-week-bar" id="week-range">Загрузка календаря...</div>
            
            <div class="schedule-grid">
                
                <!-- ПН -->
                <div class="day-card" id="day-1">
                    <h2 class="day-title">Пн <span class="day-date" id="date-1"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">10:55</span><span class="lesson-name">Естествознание</span></li>
                    </ul>
                </div>

                <!-- ВТ -->
                <div class="day-card" id="day-2">
                    <h2 class="day-title">Вт <span class="day-date" id="date-2"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Цифровая грамотность</span></li>
                    </ul>
                </div>

                <!-- СР -->
                <div class="day-card" id="day-3">
                    <h2 class="day-title">Ср <span class="day-date" id="date-3"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Русский язык</span></li>
                    </ul>
                </div>

                <!-- ЧТ -->
                <div class="day-card" id="day-4">
                    <h2 class="day-title">Чт <span class="day-date" id="date-4"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Естествознание</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Литературное чтение</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Художественный труд</span></li>
                    </ul>
                </div>

                <!-- ПТ -->
                <div class="day-card" id="day-5">
                    <h2 class="day-title">Пт <span class="day-date" id="date-5"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">08:00</span><span class="lesson-name">Математика</span></li>
                        <li class="lesson-item"><span class="lesson-time">08:55</span><span class="lesson-name">Казахский язык</span></li>
                        <li class="lesson-item"><span class="lesson-time">09:55</span><span class="lesson-name">Познание мира</span></li>
                    </ul>
                </div>

                <!-- СБ -->
                <div class="day-card" id="day-6">
                    <h2 class="day-title">Сб <span class="day-date" id="date-6"></span></h2>
                    <ul class="lesson-list">
                        <li class="lesson-item"><span class="lesson-time">09:00</span><span class="lesson-name">Самоподготовка / Кружки</span></li>
                    </ul>
                </div>

            </div>
        </div>
    </div>

    <!-- 🧠 УМНЫЙ КАЛЕНДАРНЫЙ СКРИПТ -->
    <script>
        function updateWeekSchedule() {
            const now = new Date();
            const currentDay = now.getDay(); // 0 - ВС, 1 - ПН, ..., 6 - СБ
            
            // Находим сдвиг до понедельника текущей недели
            const distanceToMonday = currentDay === 0 ? -6 : 1 - currentDay;
            
            const monday = new Date(now);
            monday.setDate(now.getDate() + distanceToMonday);

            const options = { day: 'numeric', month: 'short' };
            
            // Массив для хранения дат с ПН по СБ
            let mondayStr = "";
            let saturdayStr = "";

            // Заполняем числа для каждого дня недели (1 - ПН, 6 - СБ)
            for (let i = 1; i <= 6; i++) {
                const dayDate = new Date(monday);
                dayDate.setDate(monday.getDate() + (i - 1));
                
                // Форматируем дату (например: "19 мая")
                const formattedDate = dayDate.toLocaleDateString('ru-RU', options);
                document.getElementById(`date-${i}`).innerText = formattedDate;

                if (i === 1) mondayStr = dayDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });
                if (i === 6) saturdayStr = dayDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long' });

                // Если этот день совпадает с сегодняшним — добавляем класс .today для подсветки
                if (now.getDate() === dayDate.getDate() && now.getMonth() === dayDate.getMonth() && now.getFullYear() === dayDate.getFullYear()) {
                    document.getElementById(`day-${i}`).classList.add('today');
                }
            }

            // Выводим общую плашку недели: "Неделя: Число Месяца - Число Месяца"
            document.getElementById('week-range').innerText = `Неделя: ${mondayStr} — ${saturdayStr}`;
        }

        // Запуск при открытии страницы
        updateWeekSchedule();
    </script>
</body>
</html>
