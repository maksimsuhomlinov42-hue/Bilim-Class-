    );

    box-shadow:

    inset 0 0 10px rgba(255,255,255,0.22),

    0 4px 12px rgba(125,255,178,0.10);
}

/* =========================
   DAY CARD
========================= */

.single-display-container{

    width:100%;
    max-width:560px;

}

.day-card{

    display:none;

    padding:22px;

    border-radius:28px;

    background:
    linear-gradient(
        145deg,
        rgba(240,255,247,0.95),
        rgba(220,255,235,0.72)
    );

    border:
    1.5px solid rgba(255,255,255,0.45);

    backdrop-filter:blur(20px);

    box-shadow:

