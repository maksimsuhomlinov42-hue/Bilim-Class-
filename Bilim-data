<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>BilimClass Liquid Schedule</title>
    <style>
        body {
            background: #000; /* Черный фон для контраста */
            color: #000;
            font-family: 'Segoe UI', Roboto, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        /* Контейнер расписания в стиле жидкого стекла */
        .glass-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 40px; /* Никаких острых углов */
            padding: 30px;
            width: 350px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        .header {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 20px;
            text-align: center;
            color: #fff; /* Заголовок на темном фоне */
        }

        /* Блок таймера — максимально «жидкий» */
        .timer-display {
            background: rgba(255, 255, 255, 0.8);
            border-radius: 25px;
            padding: 20px;
            text-align: center;
            margin-bottom: 20px;
            box-shadow: inset 0 0 15px rgba(255, 255, 255, 0.5);
        }

        .timer-digits {
            font-size: 42px;
            font-weight: 900;
            letter-spacing: -2px;
            color: #000;
        }

        /* Список уроков */
        .lesson-item {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            padding: 15px;
            margin: 10px 0;
            display: flex;
            align-items: center;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: 0.3s;
        }

        .lesson-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.02);
        }

        .icon-box {
            width: 45px;
            height: 45px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 15px; /* Скругленные иконки */
            margin-right: 15px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #fff;
        }

        .lesson-info b {
            display: block;
            color: #fff;
            font-size: 16px;
        }

        .lesson-info span {
            color: rgba(255, 255, 255, 0.6);
            font-size: 13px;
        }
    </style>
</head>
<body>

    <div class="glass-card">
        <div class="header">BilimClass</div>
        
        <div class="timer-display">
            <div class="timer-digits" id="timer">12:45:00</div>
        </div>

        <div class="lesson-item">
            <div class="icon-box">📘</div>
            <div class="lesson-info">
                <b>Математика</b>
                <span>Кабинет 302</span>
            </div>
        </div>

        <div class="lesson-item">
            <div class="icon-box">🎨</div>
            <div class="lesson-info">
                <b>Искусство</b>
                <span>Кабинет 105</span>
            </div>
        </div>
    </div>

    <script>
        // Простой скрипт для обновления времени
        function updateTimer() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('ru-RU', { hour12: false });
            document.getElementById('timer').textContent = timeStr;
        }
        setInterval(updateTimer, 1000);
        updateTimer();
    </script>
</body>
</html>
