<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BilimClass AI Edition</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    <style>
        :root {
            --ios-green: #34c759;
            --glass-white: rgba(255, 255, 255, 0.4);
            --glass-deep: rgba(255, 255, 255, 0.7);
            --neo-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        body {
            margin: 0;
            padding: 15px;
            padding-bottom: 110px;
            font-family: -apple-system, system-ui, sans-serif;
            background: #f0f2f5; /* Можно заменить на картинку, код останется прозрачным */
            background: transparent !important;
            display: flex;
            justify-content: center;
            overflow-x: hidden;
        }

        .app-container {
            width: 100%;
            max-width: 420px;
            animation: zoomIn 0.6s ease;
        }

        /* Общие компоненты */
        .content-card {
            background: var(--glass-white);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-radius: 30px;
            padding: 20px;
            min-height: 400px;
            border: 1px solid rgba(255,255,255,0.4);
            box-shadow: var(--neo-shadow);
        }

        /* Стили ЧАТА */
        #chat-container {
            height: 320px;
            overflow-y: auto;
            margin-bottom: 15px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .msg {
            padding: 12px 16px;
            border-radius: 18px;
            max-width: 80%;
            font-size: 0.9rem;
            line-height: 1.4;
            animation: fadeIn 0.3s ease;
        }

        .ai-msg {
            background: rgba(255, 255, 255, 0.8);
            align-self: flex-start;
            border-bottom-left-radius: 5px;
            color: #333;
        }

        .user-msg {
            background: var(--ios-green);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 5px;
        }

        .ai-input-wrapper {
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.6);
            padding: 8px;
            border-radius: 20px;
        }

        #ai-input {
            flex: 1;
            border: none;
            background: none;
            padding: 10px;
            outline: none;
            font-size: 0.9rem;
        }

        .send-btn {
            background: var(--ios-green);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            color: white;
            cursor: pointer;
        }

        /* Остальные стили из твоего кода */
        .week-header { background: var(--glass-deep); backdrop-filter: blur(15px); padding: 15px; border-radius: 20px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; font-weight: 800; }
        .days-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; margin-bottom: 20px; }
        .day-btn { background: rgba(255, 255, 255, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.3); height: 45px; border-radius: 12px; font-weight: 800; font-size: 0.65rem; }
        .day-btn.active { background: var(--ios-green); color: white; }
        .lesson-node { display: flex; align-items: center; background: rgba(255, 255, 255, 0.8); padding: 15px; border-radius: 20px; margin-bottom: 10px; }
        
        .bottom-nav { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: 95%; max-width: 400px; height: 75px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(20px); border-radius: 25px; display: flex; justify-content: space-around; align-items: center; z-index: 10000; border: 1px solid rgba(255,255,255,0.5); }
        .nav-item { border: none; background: none; color: #999; font-weight: 900; font-size: 0.6rem; display: flex; flex-direction: column; align-items: center; gap: 4px; }
        .nav-item.active { color: var(--ios-green); }

        .screen { display: none; }
        .screen.active { display: block; }
        
        .timer-box { background: rgba(255, 255, 255, 0.7); margin-bottom: 15px; padding: 15px; border-radius: 20px; }
        .timer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 5px; text-align: center; }
        .time-part b { display: block; font-size: 1.2rem; color: var(--ios-green); }
    </style>
</head>
<body>

<div class="app-container">
    
    <div id="screen-sch" class="screen active">
        <div class="week-header">
            <button onclick="moveWeek(-1)" style="border:none; background:none; font-size:1.5rem;">‹</button>
            <span id="date-label">Загрузка...</span>
            <button onclick="moveWeek(1)" style="border:none; background:none; font-size:1.5rem;">›</button>
        </div>
        <div class="days-grid" id="days-buttons">
            <button class="day-btn" id="d1" onclick="setDay(1)">ПН</button>
            <button class="day-btn" id="d2" onclick="setDay(2)">ВТ</button>
            <button class="day-btn" id="d3" onclick="setDay(3)">СР</button>
            <button class="day-btn" id="d4" onclick="setDay(4)">ЧТ</button>
            <button class="day-btn" id="d5" onclick="setDay(5)">ПТ</button>
            <button class="day-btn" id="d6" onclick="setDay(6)">СБ</button>
            <button class="day-btn" id="d0" onclick="setDay(0)">ВС</button>
        </div>
        <div id="schedule-box" class="content-card"></div>
    </div>

    <div id="screen-tim" class="screen">
        <div class="content-card">
            <h3 style="text-align:center; margin-top:0;">События ⏳</h3>
            <div class="timer-box">
                <small>КОНЕЦ УЧЕБЫ (25 МАЯ)</small>
                <div class="timer-grid"><div class="time-part"><b id="d25">0</b><span>дн</span></div><div class="time-part"><b id="h25">0</b><span>ч</span></div><div class="time-part"><b id="m25">0</b><span>м</span></div><div class="time-part"><b id="s25">0</b><span>с</span></div></div>
            </div>
            <div class="timer-box">
                <small>ВЫПУСКНОЙ (23 МАЯ)</small>
                <div class="timer-grid"><div class="time-part"><b id="d23">0</b><span>дн</span></div><div class="time-part"><b id="h23">0</b><span>ч</span></div><div class="time-part"><b id="m23">0</b><span>м</span></div><div class="time-part"><b id="s23">0</b><span>с</span></div></div>
            </div>
            <div class="timer-box">
                <small>МОДО (13 МАЯ)</small>
                <div class="timer-grid"><div class="time-part"><b id="d13">0</b><span>дн</span></div><div class="time-part"><b id="h13">0</b><span>ч</span></div><div class="time-part"><b id="m13">0</b><span>м</span></div><div class="time-part"><b id="s13">0</b><span>с</span></div></div>
            </div>
        </div>
    </div>

    <div id="screen-ai" class="screen">
        <div class="content-card">
            <h3 style="margin-top:0;">Bilim AI 🤖</h3>
            <div id="chat-container">
                <div class="msg ai-msg">Привет! Я твой школьный ассистент. Спроси меня: "Что в понедельник?" или "Сколько до МОДО?"</div>
            </div>
            <div class="ai-input-wrapper">
                <input type="text" id="ai-input" placeholder="Ваш вопрос...">
                <button class="send-btn" onclick="askAI()">></button>
            </div>
        </div>
    </div>

    <nav class="bottom-nav">
        <button class="nav-item active" id="btn-sch" onclick="showScreen('sch')"><span>📅</span><span>ГРАФИК</span></button>
        <button class="nav-item" id="btn-ai" onclick="showScreen('ai')"><span>🤖</span><span>BILIM AI</span></button>
        <button class="nav-item" id="btn-tim" onclick="showScreen('tim')"><span>⏳</span><span>СРОКИ</span></button>
    </nav>

</div>

<script>
    let weekStart = new Date();
    const dNow = weekStart.getDay();
    weekStart.setDate(weekStart.getDate() - (dNow === 0 ? 6 : dNow - 1));

    const lessons = {
        1: [{n:"Математика", t:"12:55", e:"📐"}, {n:"Русский яз.", t:"13:40", e:"📖"}, {n:"Физкультура", t:"14:30", e:"⚽"}, {n:"Музыка", t:"15:25", e:"🎼"}, {n:"ИЗО", t:"16:15", e:"🎨"}],
        2: [{n:"Математика", t:"12:55", e:"📐"}, {n:"Английский", t:"13:40", e:"🔤"}, {n:"Лит. чтение", t:"14:30", e:"📚"}, {n:"Казахский", t:"15:25", e:"🇰🇿"}],
        3: [{n:"Русский яз.", t:"12:10", e:"📖"}, {n:"Цифр. грам.", t:"12:55", e:"💻"}, {n:"Математика", t:"13:40", e:"📐"}, {n:"Казахский", t:"14:30", e:"🇰🇿"}],
        4: [{n:"Русский яз.", t:"12:55", e:"📖"}, {n:"Математика", t:"13:40", e:"📐"}, {n:"Английский", t:"14:30", e:"🔤"}],
        5: [{n:"Русский яз.", t:"12:10", e:"📖"}, {n:"Математика", t:"12:55", e:"📐"}, {n:"Трудовое обуч.", t:"15:25", e:"🛠️"}],
        6: [], 0: []
    };

    function showScreen(type) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        document.getElementById('screen-' + type).classList.add('active');
        document.getElementById('btn-' + type).classList.add('active');
    }

    function setDay(day) {
        document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
        if(document.getElementById('d' + day)) document.getElementById('d' + day).classList.add('active');
        
        const box = document.getElementById('schedule-box');
        const list = lessons[day];
        let h = `<h3>${['Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота'][day]}</h3>`;
        
        if (!list || list.length === 0) h += "<p>Свободный день! ✨</p>";
        else {
            list.forEach(l => {
                h += `<div class="lesson-node animate__animated animate__fadeInLeft">
                    <span style="font-size:1.5rem; margin-right:15px">${l.e}</span>
                    <div><b>${l.n}</b><br><small style="color:var(--ios-green)">${l.t}</small></div>
                </div>`;
            });
        }
        box.innerHTML = h;
    }

    // ЛОГИКА ИИ
    function askAI() {
        const input = document.getElementById('ai-input');
        const chat = document.getElementById('chat-container');
        const query = input.value.toLowerCase();
        if(!query) return;

        chat.innerHTML += `<div class="msg user-msg">${input.value}</div>`;
        input.value = "";

        let reply = "Хмм, я пока не знаю ответа на это. Попробуй спросить про уроки!";
        
        if(query.includes("привет")) reply = "Привет! Я Bilim AI. Чем помочь?";
        else if(query.includes("понедельник")) reply = "В понедельник 5 уроков. Первый - Математика в 12:55.";
        else if(query.includes("вторник")) reply = "Во вторник 4 урока. Не забудь Английский!";
        else if(query.includes("модо")) reply = "МОДО начнется 13 мая. У тебя осталось немного времени на подготовку!";
        else if(query.includes("выпускной")) reply = "Выпускной уже 23 мая! Будет круто!";
        else if(query.includes("урок") || query.includes("расписание")) reply = "Ты можешь посмотреть полное расписание во вкладке 'График'.";

        setTimeout(() => {
            chat.innerHTML += `<div class="msg ai-msg">${reply}</div>`;
            chat.scrollTop = chat.scrollHeight;
        }, 600);
    }

    function updateUI() {
        const opt = { day: 'numeric', month: 'short' };
        const end = new Date(weekStart); end.setDate(weekStart.getDate()+6);
        document.getElementById('date-label').innerText = `${weekStart.toLocaleDateString('ru', opt)} - ${end.toLocaleDateString('ru', opt)}`;
        setDay(new Date().getDay());
    }

    function moveWeek(dir) { weekStart.setDate(weekStart.getDate() + (dir * 7)); updateUI(); }
    
    function runTimers() {
        const dates = { "25": 'May 25, 2026', "23": 'May 23, 2026', "13": 'May 13, 2026' };
        for (let k in dates) {
            const diff = new Date(dates[k]).getTime() - new Date().getTime();
            if (diff > 0) {
                document.getElementById('d'+k).innerText = Math.floor(diff/86400000);
                document.getElementById('h'+k).innerText = Math.floor((diff%86400000)/3600000);
                document.getElementById('m'+k).innerText = Math.floor((diff%3600000)/60000);
                document.getElementById('s'+k).innerText = Math.floor((diff%60000)/1000);
            }
        }
    }

    setInterval(runTimers, 1000);
    updateUI();
    
    // Enter для ИИ
    document.getElementById('ai-input').addEventListener('keypress', (e) => { if(e.key === 'Enter') askAI(); });
</script>
</body>
</html>
