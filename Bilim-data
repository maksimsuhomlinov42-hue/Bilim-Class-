        }

        .btn-danger:hover {
            box-shadow: 0 8px 20px rgba(244, 67, 54, 0.4);
        }

        .btn-small {
            padding: 8px 16px;
            font-size: 0.9em;
        }

        .btn-group {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        /* ==================== КАРТОЧКИ ИНФОРМАЦИИ ==================== */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .info-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            padding: 25px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .info-card:hover {
            background: rgba(255, 255, 255, 0.18);
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        .card-icon {
            font-size: 3em;
            margin-bottom: 15px;
        }

        .card-title {
            font-size: 1.3em;
            font-weight: 700;
            margin-bottom: 10px;
            color: var(--accent);
        }

        .card-value {
            font-size: 2.2em;
            font-weight: 700;
            color: var(--light);
        }

        .card-text {
            font-size: 0.95em;
            opacity: 0.9;
