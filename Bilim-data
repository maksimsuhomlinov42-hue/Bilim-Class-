            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-3px);
        }

        .btn-success {
            background: var(--success);
            color: white;
        }

        .btn-success:hover {
            box-shadow: 0 8px 20px rgba(76, 175, 80, 0.4);
        }

        .btn-danger {
            background: var(--danger);
