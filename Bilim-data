<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>BilimClass - Расписание</title>
    <style>
        :root {
            --bg: #e0e5ec;
            --glass: rgba(255, 255, 255, 0.2);
            --shadow: 9px 9px 16px rgb(163,177,198,0.6), -9px -9px 16px rgba(255,255,255, 0.5);
            --inner-shadow: inset 6px 6px 12px #b8b9be, inset -6px -6px 12px #ffffff;
        }

        body {
            background-color: var(--bg);
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        /* Таймер до 25 мая */
        #countdown {
            margin-bottom: 20px;
            padding: 15px;
            border-radius: 20px;
            background: var(--glass);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.3);
            box-shadow: var(--shadow);
            font-weight: bold;
            color: #444;
        }

        /* Навигация (Неоморфизм) */
        .nav {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .day-btn {
            padding: 10px 20px;
            border: none;
            border-radius: 12px;
            background: var(--bg);
            box-shadow: var(--shadow);
            cursor: pointer;
            transition: all 0.2s ease;
            font-weight: 600;
            color: #666;
        }

        .day-btn:active, .day-btn.active {
            box-shadow: var(--inner-shadow);
            color: #333;
            transform: scale(0.95);
        }

        /* Карточка расписания (Глассморфизм) */
        .schedule-card {
            width: 100%;
            max-width: 500px;
            background: var(--glass);
            backdrop-filter: blur(15px);
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.4);
            box-shadow: var(--shadow);
            padding: 25px;
            display: none;
        }

        .schedule-card.active {
            display: block;
            animation: fadeIn 0.5s ease;
        }

        .lesson {
            display: flex;
            justify-content: space-between;
            padding: 15px;
            margin: 10px 0;
            border-radius: 15px;
            transition: background 0.3s;
            background: rgba(255,255,255,0.1);
        }

        /* Подсветка текущего урока */
        .current-lesson {
            background: rgba(255, 255, 0, 0.4) !important;
            border: 1px solid yellow;
            box-shadow: 0 0 15px rgba(255, 255, 0, 0.3);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div id="countdown">Загрузка таймера...</div>

    <div class="nav">
        <button class="day-btn active" onclick="showDay('mon', this)">ПН</button>
        <button class="day-btn" onclick="showDay('tue', this)">ВТ</button>
        <button class="day-btn" onclick="showDay('wed', this)">СР</button>
    </div>

    <div id="mon" class="schedule-card active">
        <h3>Понедельник</h3>
        <div class="lesson" data-start="12:55" data-end="13:55"><span>Математика</span> <span>12:55-13:55</span></div>
        <div class="lesson" data-start="14:30" data-end="15:10"><span>Физкультура</span> <span>14:30-15:10</span></div>
        <div class="lesson" data-start="15:25" data-end="16:05"><span>Музыка</span> <span>15:25-16:05</span></div>
        <div class="lesson" data-start="16:15" data-end="16:55"><span>ИЗО</span> <span>16:15-16:55</span></div>
    </div>

    <div id="tue" class="schedule-card">
        <h3>Вторник</h3>
        <div class="lesson" data-start="12:10" data-end="12:50"><span>Русский язык</span> <span>12:10-12:50</span></div>
        <div class="lesson" data-start="14:30" data-end="15:10"><span>Лит. чтение</span> <span>14:30-15:10</span></div>
        <div class="lesson" data-start="15:25" data-end="16:05"><span>Казахский язык</span> <span>15:25-16:05</span></div>
    </div>

    <div id="wed" class="schedule-card">
        <h3>Среда</h3>
        <div class="lesson" data-start="12:55" data-end="13:35"><span>Русский язык</span> <span>12:55-13:35</span></div>
        <div class="lesson" data-start="13:40" data-end="14:20"><span>Математика</span> <span>13:40-14:20</span></div>
        <div class="lesson" data-start="15:25" data-end="16:05"><span>Лит. чтение</span> <span>15:25-16:05</span></div>
    </div>

    <script>
        function showDay(dayId, btn) {
            document.querySelectorAll('.schedule-card').forEach(c => c.classList.remove('active'));
            document.querySelectorAll('.day-btn').forEach(b => b.classList.remove('active'));
            document.getElementById(dayId).classList.add('active');
            btn.classList.add('active');
        }

        // Таймер до 25 мая
        function updateTimer() {
            const end = new Date('May 25, 2026 00:00:00').getTime();
            const now = new Date().getTime();
            const diff = end - now;
            
            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            document.getElementById('countdown').innerText = `До каникул (25 мая): ${days}д ${hours}ч`;
        }

        // Подсветка урока
        function checkLessons() {
            const now = new Date();
            const currentTime = now.getHours() * 60 + now.getMinutes();

            document.querySelectorAll('.lesson').forEach(lesson => {
                const [startH, startM] = lesson.dataset.start.split(':').map(Number);
                const [endH, endM] = lesson.dataset.end.split(':').map(Number);
                const start = startH * 60 + startM;
                const end = endH * 60 + endM;

                if (currentTime >= start && currentTime <= end) {
                    lesson.classList.add('current-lesson');
                } else {
                    lesson.classList.remove('current-lesson');
                }
            });
        }

        setInterval(updateTimer, 1000);
        setInterval(checkLessons, 1000);
        updateTimer();
        checkLessons();
    </script>
</body>
</html>
